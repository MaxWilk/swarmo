{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Swarmo window is allowed to do. Commands defined by the app itself do not need to be listed; only plugin and core APIs do.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",

    "opener:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
