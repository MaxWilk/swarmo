{
  "info": {
    "_postman_id": "11111111-1111-1111-1111-111111111111",
    "name": "Orders API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.environment.set('requestedAt', String(Date.now()));"]
      }
    }
  ],
  "item": [
    {
      "name": "List orders",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/orders?limit=10&status=open",
          "host": ["{{baseUrl}}"],
          "path": ["orders"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "status", "value": "open" },
            { "key": "cursor", "value": "abc", "disabled": true }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"A-1\",\n  \"qty\": 2\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/orders" }
      }
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Delete order",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "hunter2" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/orders/1" }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com" },
    { "key": "apiKey", "value": "", "type": "secret" }
  ]
}
